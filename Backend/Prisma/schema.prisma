// =====================================
// Prisma Config
// =====================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================
// ENUMS
// =====================================
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum PentestStatus {
  PLANNING
  IN_PROGRESS
  REPORTING
  CLOSED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  TRIAGED
  FIXED
  PENDING_RETEST
  VALIDATED
  REOPENED
  ACCEPTED_RISK
}

enum RoleType {
  SUPER_ADMIN
  ORG_ADMIN
  PROJECT_ADMIN
  PENTESTER
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// =====================================
// 1️⃣ User
// =====================================
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String? // Optional for OAuth users
  fullName     String
  handle       String     @unique
  status       UserStatus @default(PENDING)
  isVerified   Boolean    @default(false)
  trustScore   Int        @default(100)

  // OAuth fields
  provider   String? // 'local', 'google', 'github', etc.
  providerId String? // OAuth provider's user ID
  auth0Id    String? @unique // Auth0 identifier
  avatar     String? // Profile picture URL

  // Email verification
  emailVerifiedAt DateTime?

  // Login tracking
  lastLoginAt DateTime?

  // Relations
  organizations           OrganizationMember[]
  roles                   Role[] // Direct relation to Role
  pentestsLed             Pentest[]                @relation("LeadPentester")
  findingsReported        Finding[]                @relation("FindingReporter") // Changed from 'findings'
  aiAgents                AiAgent[]                @relation("AiAgentUser")
  pentestCollaborators    PentestCollaborator[]
  userSignatures          UserSignature[]
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  workflowHistories       WorkflowHistory[]
  findingComments         FindingComment[]
  
  wallet                  Wallet?
  transactions            Transaction[]
  reviewsWritten          Review[] @relation("ReviewAuthor")
  reviewsReceived         Review[] @relation("ReviewSubject")

  // Hacker profile (for PENTESTER users)
  hackerProfile          HackerProfile?
  reviewedHackerProfiles HackerProfile[] @relation("HackerProfileReviewedBy")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([email])
  @@index([handle])
  @@index([status])
  @@index([provider])
}

// =====================================
// 1️⃣6️⃣ HackerProfile
// =====================================

model HackerProfile {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  bio               String?
  country           String?
  yearsOfExperience Int?
  primarySkills     String[]
  certifications    String[]
  portfolioLinks    String[]
  specialization    String?
  idDocumentNumber  String?
  githubUsername    String?
  linkedinProfile   String?
  twitter           String?

  status      VerificationStatus @default(DRAFT)
  reviewNotes String?

  reviewedBy   User?   @relation("HackerProfileReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// =====================================
// 2️⃣ Role
// =====================================
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  type        RoleType @unique
  description String?
  permissions String[] // Array of permission strings

  // Relations
  users User[] // Many-to-many with User

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// =====================================
// 3️⃣ Organization
// =====================================
model Organization {
  id   String @id @default(uuid())
  name String
  slug String @unique

  // Profile Information
  description  String?
  industry     String?
  size         String?
  website      String?
  primaryEmail String?
  phoneNumber  String?

  // International / Location Info
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  timezone     String?
  currency     String?

  // Legal / Tax Info
  registrationNumber String?
  taxId              String?

  // Relations
  members   OrganizationMember[]
  pentests  Pentest[]
  auditLogs AuditLog[]

  // Verification Details
  companySize       String?
  verificationStatus VerificationStatus @default(DRAFT)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, slug])
}

// =====================================
// 4️⃣ OrganizationMember
// =====================================
model OrganizationMember {
  id   String @id @default(uuid())
  role String @default("member")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Permissions
  canCreatePentests Boolean @default(false)
  canInviteMembers  Boolean @default(false)

  // Timestamps
  joinedAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// =====================================
// 5️⃣ Pentest
// =====================================
model Pentest {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      PentestStatus @default(PLANNING)

  // Personal workspace flag — true for solo hacker projects, no org required
  isPersonal Boolean @default(false)

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  leadPentester   User?   @relation("LeadPentester", fields: [leadPentesterId], references: [id])
  leadPentesterId String?

  collaborators PentestCollaborator[]
  findings      Finding[]
  aiAgents      AiAgent[]             @relation("PentestAiAgent")
  auditLogs     AuditLog[] // Added opposite relation
  workflows     Workflow[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leadPentesterId])
  @@index([status])
  @@index([isPersonal])
}

// =====================================
// 6️⃣ PentestCollaborator
// =====================================
model PentestCollaborator {
  id String @id @default(uuid())

  // Relations
  pentest   Pentest @relation(fields: [pentestId], references: [id])
  pentestId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  role String @default("collaborator")

  // Permissions
  canEditFindings   Boolean @default(false)
  canManageSessions Boolean @default(false)

  // Timestamps
  addedAt DateTime @default(now())

  @@unique([pentestId, userId])
  @@index([pentestId])
  @@index([userId])
}

// =====================================
// 7️⃣ Finding
// =====================================
model Finding {
  id          String          @id @default(uuid())
  title       String
  description String?
  severity    FindingSeverity @default(LOW)
  status      FindingStatus   @default(OPEN)
  remediation String?
  proof       String?

  // Relations
  pentest   Pentest @relation(fields: [pentestId], references: [id])
  pentestId String

  reporter   User?   @relation("FindingReporter", fields: [reporterId], references: [id])
  reporterId String?

  comments FindingComment[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pentestId])
  @@index([severity])
  @@index([status])
}

// =====================================
// 7.1 FindingComment
// =====================================
model FindingComment {
  id      String @id @default(uuid())
  content String

  // Relations
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([userId])
}

// =====================================
// 8️⃣ LegalAgreement
// =====================================
model LegalAgreement {
  id       String  @id @default(uuid())
  title    String
  content  String
  version  String
  isActive Boolean @default(true)
  type     String  @default("terms_of_service")

  // Relations
  signatures UserSignature[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, version])
}

// =====================================
// 9️⃣ UserSignature
// =====================================
model UserSignature {
  id String @id @default(uuid())

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  agreement   LegalAgreement @relation(fields: [agreementId], references: [id])
  agreementId String

  // Metadata
  ipAddress String?
  userAgent String?
  signedAt  DateTime @default(now())

  @@unique([userId, agreementId])
  @@index([userId])
  @@index([agreementId])
}

// =====================================
// 🔟 AiAssistant
// =====================================
model AiAssistant {
  id           String   @id @default(uuid())
  name         String
  model        String
  systemPrompt String
  capabilities String[]

  // Relations
  aiAgents AiAgent[]

  // Configuration
  temperature Float?  @default(0.7)
  maxTokens   Int?    @default(2000)
  isActive    Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([model])
}

// =====================================
// 1️⃣1️⃣ AiAgent
// =====================================
model AiAgent {
  id String @id @default(uuid())

  // Relations
  assistant   AiAssistant @relation(fields: [assistantId], references: [id])
  assistantId String

  user   User   @relation("AiAgentUser", fields: [userId], references: [id])
  userId String

  pentest   Pentest? @relation("PentestAiAgent", fields: [pentestId], references: [id])
  pentestId String?

  // Agent data
  name       String?
  messages   Json?
  tokensUsed Int?    @default(0)
  isActive   Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pentestId])
  @@index([assistantId])
}

// =====================================
// 1️⃣2️⃣ AuditLog
// =====================================
model AuditLog {
  id        String  @id @default(uuid())
  action    String
  details   Json?
  ipAddress String?
  userAgent String?

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  pentest   Pentest? @relation(fields: [pentestId], references: [id])
  pentestId String?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([pentestId])
  @@index([createdAt])
}

// =====================================
// 1️⃣3️⃣ EmailVerificationToken
// =====================================
model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// =====================================
// 1️⃣4️⃣ PasswordResetToken
// =====================================
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Timestamps
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// =====================================
// 1️⃣5️⃣ RefreshToken
// =====================================
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)

  // Device/Session info
  userAgent String?
  ipAddress String?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Timestamps
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// =====================================
// 1️⃣6️⃣ Workflow
// =====================================
model Workflow {
  id   String @id @default(uuid())
  name String @default("Untitled Workflow")

  // The current state of the workflow (nodes and connections)
  nodes Json @default("[]")
  edges Json @default("[]")

  // Relations
  pentest   Pentest @relation(fields: [pentestId], references: [id], onDelete: Cascade)
  pentestId String

  history WorkflowHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pentestId])
}

// =====================================
// 1️⃣7️⃣ WorkflowHistory
// =====================================
model WorkflowHistory {
  id String @id @default(uuid())

  // Relations
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Versioning Details
  action  String // e.g., "NODE_ADDED", "NODE_MOVED", "TEXT_CHANGED"
  details Json? // The delta/diff (what specifically changed)

  // Snapshot (Optional: save the full state every 10-20 changes for easy rollback)
  isSnapshot Boolean @default(false)
  snapshot   Json? // The full { nodes, edges } state at this point in time

  createdAt DateTime @default(now())

  @@index([workflowId])
  @@index([userId])
  @@index([createdAt])
}

// =====================================
// 1️⃣8️⃣ Wallet (Escrow / Balance)
// =====================================
model Wallet {
  id      String @id @default(uuid())
  balance Float  @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================
// 1️⃣9️⃣ Transaction
// =====================================
model Transaction {
  id          String   @id @default(uuid())
  type        String   // e.g. "CREDIT", "DEBIT", "PAYOUT", "ESCROW_HOLD", "ESCROW_RELEASE"
  amount      Float
  description String?
  status      String   @default("COMPLETED")
  reference   String?

  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([userId])
}

// =====================================
// 2️⃣0️⃣ Review
// =====================================
model Review {
  id      String @id @default(uuid())
  rating  Int    // 1-5 stars
  comment String?

  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId String

  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id])
  subjectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([subjectId])
}
